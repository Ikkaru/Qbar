# CMake / MSVC output. Regenerated by `cmake --build build --config Release`,
# so there is nothing here worth versioning.
build/
out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.sln
*.vcxproj
*.vcxproj.filters
.vs/

# Build artefacts from the Phase 0 AppBar spike. The source stays: it is the
# evidence behind the manual-autohide decision recorded in the plan.
spike/*.exe
spike/*.err
spike/*.obj

# The unsubsetted Material Symbols font, ~1.2 MB. It is a build input that gets
# re-downloaded from Google Fonts and then reduced with pyftsubset; only the
# 39 KB result in resources/fonts/ is actually shipped.
MaterialSymbolsRounded-full.ttf

# Runtime and installer logs. qbar.log is written by the app itself.
*.log
*.out

# Leftovers from redirecting the GUI binary's stdio while debugging a QML
# binding that was failing silently.
qbar-stdout.txt
qbar-stderr.txt

# Qt's icns/png icon exports, regenerated by windeployqt packaging.
*.icns
*.app
